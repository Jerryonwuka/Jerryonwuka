# Model access. Without this, only --simulate runs work.
ANTHROPIC_API_KEY=

# Outbound email. driver: dryrun | resend
EMAIL_DRIVER=dryrun
RESEND_API_KEY=
EMAIL_FROM="Your Name <you@yourdomain.com>"
# CAN-SPAM requires a real postal address in every commercial email.
EMAIL_POSTAL_ADDRESS="1 Example St, Lagos, Nigeria"

# Prospect research. driver: dryrun | serper
RESEARCH_DRIVER=dryrun
SERPER_API_KEY=

# Booking. driver: dryrun | calcom
CALENDAR_DRIVER=dryrun
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
