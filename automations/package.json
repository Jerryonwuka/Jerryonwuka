    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  },
  "dependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.9"
  }
}
