{
  "name": "@jerry/automations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent automation engine: durable workflows, typed connectors, Claude-driven steps.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "cli": "node --experimental-strip-types --no-warnings src/cli.ts",
